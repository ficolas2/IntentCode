#import repository.icode
#import types.icode
#import utils.icode

data LinkResponse [ json {
    {
        "type": "object",
        "properties": {
            "slug":    { "type": "string" },
            "target":  { "type": "string", "format": "uri" },
            "created": { "type": "string", "format": "date-time" },
            "expires": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["slug", "target", "created", "expires"]
    }
}]

component Api [
    Repository

    GET /url?slug -> LinkResponse [
        assumption [
            slug.len > 3 so that /url is never a valid slug
        ]

        @Repository.get(slug)

        Status: 
          - 404 if there is no such slug
          - 410 if the link exists but has expired or was soft deleted
          - 400 if slug is missing or does not satisfy the constraint of Link.slug
          - 503 on Unavailable
    ]

    GET /{slug} [

        @Repository.get(slug)

        Status: 
          - 302 redirect to the link target
          - 404 if there is no such slug
          - 410 if the link exists but has expired or was soft deleted
          - 400 if slug does not satisfy the constraint of Link.slug
          - 503 on Unavailable
    ]

    POST /url { "target": url, "expires"?: time } -> LinkResponse [
        assumption [
            Another request can take the chosen slug between the query and the insert, so Duplicate from insert is an expected outcome, not a bug
        ]

        [
            // The compiler will ask the LLM to fill in blocks in angle brackets 
            // like <hashing algorithm>
            hash = [Hash the target using <hashing algorithm>]
            links = @Repository.with_prefix(hash[0:4])


            if !links.contains(target) [
                slug = [smallest prefix of hash that is not used by another link]
                @Repository.insert(@Link(
                    slug,
                    target,
                    created: now,
                    expires or 30d default
                ))
            ] else [
                the existing link is the answer
                if it has expired or is soft deleted, @Repository.renew(its slug, expires or 30d default) first
            ]
        ] @retry(2^n*0.05s, 3 tries) on Duplicate
        // On Duplicate another request took the slug first. Retries help race condition.

        Status:
          - 201 with the stored link
          - 200 with the existing link, nothing inserted, if a link with the same target already exists (renewed first if it had expired)
          - 400 if target is not a valid url, or expires is invalid or not in the future
          - 409 if every prefix of hash is the slug of a link with a different target
          - 503 on Unavailable, or if insert is still Duplicate after the retries
    ]

]
